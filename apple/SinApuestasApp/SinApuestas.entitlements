<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Permiso de Apple para usar Family Controls / Screen Time. -->
    <key>com.apple.developer.family-controls</key>
    <true/>
    <!-- App Group compartido entre la app y las extensiones (monitor + escudo).
         Debe ser IDENTICO en los 3 targets. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.sinapuestas.shared</string>
    </array>
</dict>
</plist>
